FROM python:3.13-slim
WORKDIR /app
COPY requirements-server.txt .
RUN pip install --no-cache-dir -r requirements-server.txt
COPY server/ server/
COPY alembic/ alembic/
COPY alembic.ini .
CMD ["sh", "-c", "export DATABASE_URL=postgresql+psycopg://$POSTGRES_USER:$POSTGRES_PASSWORD@db:5432/$POSTGRES_DB && alembic upgrade head && exec uvicorn server.main:app --host 0.0.0.0 --port 8000"]
