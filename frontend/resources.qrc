    <qresource prefix="/illustrations">
        <file alias="auth.svg">resources/illustrations/auth.svg</file>
        <file alias="home.svg">resources/illustrations/home.svg</file>
        <file alias="tracking.svg">resources/illustrations/tracking.svg</file>
    </qresource>
</RCC>
