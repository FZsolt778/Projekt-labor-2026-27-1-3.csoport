    <qresource prefix="/icons">
        <file alias="auth.svg">resources/icons/auth.svg</file>
        <file alias="mail.svg">resources/icons/mail.svg</file>
        <file alias="lock-keyhole.svg">resources/icons/lock-keyhole.svg</file>
